{
  "buildCommand": "cd frontend && npm install && npm run build && mkdir -p ../dist && cp -r dist/. ../dist/",
  "builds": [
    { "src": "dist/**", "use": "@vercel/static" },
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/assets/(.*)", "dest": "/dist/assets/$1" },
    { "src": "/favicon\\.svg", "dest": "/dist/favicon.svg" },
    { "src": "/(.*)", "dest": "/dist/index.html" }
  ],
  "env": {
    "VERCEL": "1",
    "DATABASE_SQLITE_PATH": "/tmp/spider_xhs.db",
    "DATABASE_TYPE": "sqlite",
    "SECRET_KEY": "vercel-deploy-change-me-in-production",
    "BACKEND_CORS_ORIGINS": "*"
  }
}
