{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "https://你的服务器IP:8000/api/$1" },
    { "src": "/assets/(.*)", "dest": "/dist/assets/$1" },
    { "src": "/favicon\\.svg", "dest": "/dist/favicon.svg" },
    { "src": "/(.*)", "dest": "/dist/index.html" }
  ]
}
