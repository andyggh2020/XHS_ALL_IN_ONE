{
  "buildCommand": "cd frontend && npm install && npm run build",
  "builds": [
    { "src": "frontend/dist/**", "use": "@vercel/static" },
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/frontend/dist/assets/$1" },
    { "src": "/favicon\\.svg", "dest": "/frontend/dist/favicon.svg" },
    { "src": "/logo\\.jpg", "dest": "/frontend/dist/logo.jpg" },
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "env": {
    "VERCEL": "1",
    "DATABASE_SQLITE_PATH": "/tmp/spider_xhs.db",
    "DATABASE_TYPE": "sqlite",
    "SECRET_KEY": "vercel-deploy-change-me-in-production",
    "BACKEND_CORS_ORIGINS": "*"
  }
}
